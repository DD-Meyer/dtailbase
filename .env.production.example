# Production VPS defaults
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-strong-secret

ALLOWED_HOSTS=detailerflow.netictechnologies.com,www.detailerflow.netictechnologies.com
CORS_ALLOWED_ORIGINS=https://detailerflow.netictechnologies.com,https://www.detailerflow.netictechnologies.com
CSRF_TRUSTED_ORIGINS=https://detailerflow.netictechnologies.com,https://www.detailerflow.netictechnologies.com

USE_POSTGRES=True
# Preferred in production:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Or PostgreSQL fallback variables if DATABASE_URL is not set:
# POSTGRES_DB=bookingdb
# POSTGRES_USER=bookinguser
# POSTGRES_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
