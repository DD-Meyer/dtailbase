# Production VPS defaults
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-strong-secret
PUBLIC_BASE_URL=https://www.dtailbase.com
FRONTEND_URL=https://www.dtailbase.com

# PayFast (use live credentials in production)
PAYFAST_MODE=live
PAYFAST_LIVE_MERCHANT_ID=replace-on-server
PAYFAST_LIVE_MERCHANT_KEY=replace-on-server
PAYFAST_LIVE_PASSPHRASE=replace-on-server
PAYFAST_NOTIFY_URL=https://www.dtailbase.com/api/payments/payfast/notify/
# Plan pricing/limits are edited in Django admin > Plan configurations (PayFast bills in ZAR)
# Password-reset email: configure your existing SMTP provider on the server.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-on-server
EMAIL_HOST_PASSWORD=replace-on-server
DEFAULT_FROM_EMAIL=noreply@dtailbase.com
EMAIL_TIMEOUT=10
PASSWORD_RESET_TIMEOUT=3600
# Shared throttling across API workers; run manage.py createcachetable.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=dtailbase_cache
# Supervise: manage.py send_password_resets --watch

ALLOWED_HOSTS=dtailbase.com,www.dtailbase.com
CORS_ALLOWED_ORIGINS=https://dtailbase.com,https://www.dtailbase.com
CSRF_TRUSTED_ORIGINS=https://dtailbase.com,https://www.dtailbase.com

USE_POSTGRES=True
# Preferred in production:
# DATABASE_URL=postgres://dtailbase_prod_user:strong-password@127.0.0.1:5432/dtailbase_prod

# Or PostgreSQL fallback variables if DATABASE_URL is not set:
# POSTGRES_DB=dtailbase_prod
# POSTGRES_USER=dtailbase_prod_user
# POSTGRES_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
