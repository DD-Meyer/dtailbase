# Production VPS defaults
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-strong-secret
PUBLIC_BASE_URL=https://www.detely.com

ALLOWED_HOSTS=detely.com,www.detely.com
CORS_ALLOWED_ORIGINS=https://detely.com,https://www.detely.com
CSRF_TRUSTED_ORIGINS=https://detely.com,https://www.detely.com

USE_POSTGRES=True
# Preferred in production:
# DATABASE_URL=postgres://detely_prod_user:strong-password@127.0.0.1:5432/detely_prod

# Or PostgreSQL fallback variables if DATABASE_URL is not set:
# POSTGRES_DB=detely_prod
# POSTGRES_USER=detely_prod_user
# POSTGRES_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
